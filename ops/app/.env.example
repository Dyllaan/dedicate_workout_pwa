# Production application env for docker-compose.prod.yml.
# Copy to `.env.prod.app` and replace every placeholder before deploying.

DOCKER_REGISTRY=dflouis
IMAGE_TAG=replace-with-git-sha
FRONTEND_PORT=80
VITE_API_URL=/api/

JWT_ISSUER=dedicate-production
JWT_PUBLIC_KEY_B64=replace-with-base64-x509-public-key
JWT_PRIVATE_KEY_B64=replace-with-base64-pkcs8-private-key
TEMP_MFA_SECRET_KEY=replace-with-high-entropy-secret

AUTH_DATABASE_URL=jdbc:postgresql://dedicate-auth-db:5432/auth?sslmode=disable
AUTH_DATABASE_USERNAME=auth_user
AUTH_DATABASE_PASSWORD=replace-with-secret
AUTH_DB_SSL_ENABLED=false
AUTH_DB_SSL_MODE=disable
AUTH_REDIS_HOST=dedicate-auth-redis
AUTH_REDIS_PORT=6379

WORKOUT_DATABASE_URL=jdbc:postgresql://dedicate-workout-db:5432/workout?sslmode=disable
WORKOUT_DATABASE_USERNAME=workout_user
WORKOUT_DATABASE_PASSWORD=replace-with-secret
WORKOUT_DB_SSL_ENABLED=false
WORKOUT_DB_SSL_MODE=disable

KAFKA_BOOTSTRAP_SERVERS=dedicate-kafka:9092
