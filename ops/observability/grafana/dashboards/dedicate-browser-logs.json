{
  "uid": "dedicate-browser-logs",
  "title": "Dedicate Browser Logs",
  "tags": ["loki", "logging", "dedicate", "browser"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "environment",
        "label": "Environment",
        "query": "local,production",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "local",
          "value": "local"
        }
      },
      {
        "type": "textbox",
        "name": "request_id",
        "label": "Request ID",
        "query": ".*",
        "current": {
          "selected": true,
          "text": "Any",
          "value": ".*"
        }
      },
      {
        "type": "custom",
        "name": "browser_level",
        "label": "Browser level",
        "query": "warn,error",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Browser event volume",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=\"api-gateway\"} | json | event_type=\"browser_log\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Browser error volume",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=\"api-gateway\"} | json | event_type=\"browser_log\" | browser_level=~\"$browser_level\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request-correlated browser traffic",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=\"api-gateway\", request_id=~\"$request_id\"} | json | event_type=\"browser_log\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent browser events",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\", service=\"api-gateway\", request_id=~\"$request_id\"} | json | event_type=\"browser_log\" | browser_level=~\"$browser_level\""
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Raw browser event drilldown",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\", service=\"api-gateway\", request_id=~\"$request_id\"} | json | event_type=\"browser_log\""
        }
      ]
    }
  ]
}
