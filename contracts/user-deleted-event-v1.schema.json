{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-deleted-event-v1.schema.json",
  "title": "UserDeletedEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "userId", "source"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "USER_DELETED"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
