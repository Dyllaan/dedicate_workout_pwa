{
  "uid": "dedicate-overview",
  "title": "Dedicate Overview",
  "tags": ["loki", "logging", "dedicate", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "environment",
        "label": "Environment",
        "query": "local,production",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "local",
          "value": "local"
        }
      },
      {
        "type": "custom",
        "name": "app_services",
        "label": "App services",
        "query": "frontend,api-gateway,auth-service,workout-service",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "App error spike",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=~\"$app_services\"} |~ \"(?i)error|exception|panic|fatal\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Browser error spike",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=\"api-gateway\"} | json | event_type=\"browser_log\" | browser_level=\"error\" [5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Recent critical logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=~\"$app_services\"} |~ \"(?i)error|exception|panic|fatal\" [1h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingestion activity",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=~\"$environment\", service=~\"$app_services\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent app logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=~\"$environment\", service=~\"$app_services\"} | json"
        }
      ]
    },
    {
      "id": 6,
      "type": "text",
      "title": "Drilldowns",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "options": {
        "mode": "markdown",
        "content": "## Drilldowns\\n- [App logs](/d/dedicate-logs?orgId=1&var-environment=$environment)\\n- [Browser logs](/d/dedicate-browser-logs?orgId=1&var-environment=$environment)"
      }
    }
  ]
}
